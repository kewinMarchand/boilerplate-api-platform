<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Blog\Domain\ArticleTerm" table="article_term">
        <unique-constraints>
            <unique-constraint name="article_term_kind_slug" columns="kind,slug"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="kind" type="string" length="7" enum-type="App\Blog\Domain\ArticleTermKind"/>
        <field name="slug" type="string" length="60"/>
        <field name="name" type="string" length="60"/>
        <field name="position" type="integer"/>
    </entity>
</doctrine-mapping>
